# Configuración del servidor Express
PORT=3000
JWT_SECRET=
LOGIN_RATE_LIMIT_IP_MAX=30
LOGIN_RATE_LIMIT_ACCOUNT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
CORS_ORIGINS=http://localhost:3000

# Configuración de Supabase
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
PASSWORD_RESET_REDIRECT_URL=http://localhost:3000/auth/cambiar-password.html

# La recuperación de contraseña usa el correo administrado por Supabase Auth.
