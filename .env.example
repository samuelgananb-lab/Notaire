# Configuración del servidor Express
PORT=3000
JWT_SECRET=
CRON_SECRET=
CORS_ORIGINS=http://localhost:3000

# Configuración de IA (Claude API)
ANTHROPIC_API_KEY=

# Configuración de Supabase
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
PASSWORD_RESET_REDIRECT_URL=http://localhost:3000/auth/cambiar-password.html

# Base de datos legacy (SQL Server; el servidor actual usa Supabase)
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=NotaireDB
DB_USER=
DB_PASSWORD=
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# Correo transaccional con Resend
EMAIL_PROVIDER=resend
EMAIL_MODE=development
RESEND_API_KEY=
MAIL_FROM="Notaire <onboarding@resend.dev>"
MAIL_TEST_RECIPIENT=
PUBLIC_APP_URL=http://localhost:3000
